{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 120,
      "excludeFiles": "{backend/tests/**,frontend/tests/**,**/__pycache__/**}"
    }
  },
  "crons": [
    { "path": "/api/cron/daily", "schedule": "10 21 * * *" },
    { "path": "/api/cron/daily", "schedule": "10 5 * * *" },
    { "path": "/api/cron/daily", "schedule": "10 11 * * *" },
    { "path": "/api/cron/daily", "schedule": "10 16 * * *" }
  ]
}
